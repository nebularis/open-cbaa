@prefix : <https://nebularis.github.io/open-dare/ontology/lma-wim/policy#> .
@prefix core: <https://nebularis.github.io/open-dare/ontology/lma-wim/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://nebularis.github.io/open-dare/ontology/lma-wim/policy> a owl:Ontology ;
    rdfs:label "LMA Wordings Information Model — Policy"@en ;
    rdfs:comment "Policy branch of the Contract typing: Insurance, Reinsurance."@en ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://nebularis.github.io/open-dare/ontology/lma-wim/core> .

:Policy a owl:Class ;
    rdfs:subClassOf core:Contract, core:PolicyRelated ;
    rdfs:label "Policy"@en .

:Insurance a owl:Class ;
    rdfs:subClassOf :Policy ;
    rdfs:label "Insurance"@en .

:Reinsurance a owl:Class ;
    rdfs:subClassOf :Policy ;
    rdfs:label "Reinsurance"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( :Insurance :Reinsurance ) .
