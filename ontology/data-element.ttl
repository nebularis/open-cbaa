@prefix : <https://nebularis.github.io/open-cbaa/ontology/lma-wim/data-element#> .
@prefix core: <https://nebularis.github.io/open-cbaa/ontology/lma-wim/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://nebularis.github.io/open-cbaa/ontology/lma-wim/data-element> a owl:Ontology ;
    rdfs:label "LMA Wordings Information Model — Data Element"@en ;
    rdfs:comment "Data Element typing: Text, Table, Variable, Metadata, Reference, and their Sub-Typing."@en ;
    owl:versionInfo "0.1.0" ;
    owl:imports <https://nebularis.github.io/open-cbaa/ontology/lma-wim/core> .

:Text a owl:Class ;
    rdfs:subClassOf core:DataElement ;
    rdfs:label "Text"@en ;
    skos:altLabel "TXT" ;
    rdfs:comment "i.e. content, per LMA WIM."@en .

:Table a owl:Class ;
    rdfs:subClassOf core:DataElement ;
    rdfs:label "Table"@en .

:Variable a owl:Class ;
    rdfs:subClassOf core:DataElement ;
    rdfs:label "Variable"@en ;
    skos:altLabel "VAR" .

:Metadata a owl:Class ;
    rdfs:subClassOf core:DataElement ;
    rdfs:label "Metadata"@en .

:Reference a owl:Class ;
    rdfs:subClassOf core:DataElement ;
    rdfs:label "Reference"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( :Text :Table :Variable :Metadata :Reference ) .

#################################################################
# Text
#################################################################

:Title a owl:Class ;
    rdfs:subClassOf :Text ;
    rdfs:label "Title"@en ;
    skos:altLabel "HDG" ;
    rdfs:comment "Extensible to subtitle."@en .

:Paragraph a owl:Class ; rdfs:subClassOf :Text ; rdfs:label "Paragraph"@en .

:NumberedClauseText a owl:Class ;
    rdfs:subClassOf :Text ;
    rdfs:label "Numbered Clause"@en .

:NestedClauseText a owl:Class ;
    rdfs:subClassOf :Text ;
    rdfs:label "Nested Clause"@en .

:OrderedList a owl:Class ; rdfs:subClassOf :Text ; rdfs:label "Ordered List"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( :Title :Paragraph :NumberedClauseText :NestedClauseText :OrderedList ) .

#################################################################
# Table
#################################################################

:DynamicTable a owl:Class ;
    rdfs:subClassOf :Table ;
    rdfs:label "Dynamic Table"@en ;
    skos:altLabel "DTB" .

:StaticTable a owl:Class ;
    rdfs:subClassOf :Table ;
    rdfs:label "Static Table"@en ;
    skos:altLabel "STB" .

[] a owl:AllDisjointClasses ;
    owl:members ( :DynamicTable :StaticTable ) .

#################################################################
# Variable
#################################################################

:EmbeddedVariable a owl:Class ;
    rdfs:subClassOf :Variable ;
    rdfs:label "Embedded Variable"@en .

:GoverningVariable a owl:Class ;
    rdfs:subClassOf :Variable ;
    rdfs:label "Governing Variable (Optionality)"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( :EmbeddedVariable :GoverningVariable ) .

#################################################################
# Metadata
#################################################################

:DescriptiveMetadata a owl:Class ;
    rdfs:subClassOf :Metadata ;
    rdfs:label "Descriptive Metadata"@en .

:SystemMetadata a owl:Class ;
    rdfs:subClassOf :Metadata ;
    rdfs:label "System Metadata"@en .

[] a owl:AllDisjointClasses ;
    owl:members ( :DescriptiveMetadata :SystemMetadata ) .

#################################################################
# Reference — "links to", not a subtype relation
#################################################################

:InternalObject a owl:Class ;
    rdfs:label "Other Internal Object"@en ;
    rdfs:comment "Placeholder for an arbitrary internal object elsewhere in the same contract (a Component or Data Element) not already covered by Definition or Table. Refine once cross-referencing patterns are better understood."@en .

:ExternalDocument a owl:Class ;
    rdfs:label "External Document"@en ;
    rdfs:comment "A document external to the contract's own structure, e.g. a referenced regulation, standard, or separate agreement. Refine in a later iteration."@en .

[] a owl:AllDisjointClasses ;
    owl:members ( :InternalObject :ExternalDocument ) .

:linksTo a owl:ObjectProperty ;
    rdfs:domain :Reference ;
    rdfs:range [ a owl:Class ; owl:unionOf ( core:Definition :InternalObject :ExternalDocument :Table ) ] ;
    rdfs:label "links to"@en ;
    rdfs:comment "Realises the 'Links to' relation from Reference to Definition, another internal object, an external document, or a Table, per the LMA WIM legend. Distinct from the is-a-subtype-of and comprises relations used elsewhere in this ontology."@en .
